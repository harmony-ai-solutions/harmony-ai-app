	<string>Soulbits uses the camera to scan the pairing QR code shown in the Soulbits Cloud portal</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID is used to unlock the app</string>
	<key>UIBackgroundModes</key>
	<array>
