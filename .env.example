# react-native-config (iOS) + build-time reference.
#
# This file is a TEMPLATE — the real `.env` is GENERATED per environment by
# `scripts/oauth-secrets.cjs`:
#
#   npm run oauth:dev    # reads secrets/dev/client_secret_*.json (or the
#                        # repo-root client_secret_*.json) → writes .env
#   npm run oauth:prod   # same for production
#
# The loader derives GOOGLE_WEB_CLIENT_ID from the GCP OAuth client secret
# JSON (which is NEVER committed — see .gitignore `client_secret_*.json`),
# so no OAuth credentials are hardcoded in tracked files.
#
# On Android these come from productFlavors buildConfigField
# (android/app/build.gradle) which resolves -P flags, then
# android/gradle-secrets.<flavor>.properties (also generated by the loader).
# On iOS, react-native-config reads this generated .env (repo root); CI
# regenerates it per environment before xcodebuild (see
# .github/workflows/build-release.yml). Local dev: __DEV__ short-circuits
# IS_BETA to true regardless, so this file only affects RELEASE builds.
#
# Values are non-sensitive (ship in client binaries).
APP_ENV=dev
# Distribution variant (plan 7-14): 'full' (default, self-built/sideload) or
# 'store' (Play/App Store listing — store owns updates, APK self-updater OFF).
# On Android this is a per-flavour buildConfigField; on iOS/Metro it is written
# into the generated .env by scripts/oauth-secrets.cjs (override with
# `APP_VARIANT=store` or `--variant=store`).
APP_VARIANT=full
IS_BETA=true
GOOGLE_WEB_CLIENT_ID=
APPLE_SERVICES_ID=

